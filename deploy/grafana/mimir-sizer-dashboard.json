          "expr": "sum by (url) (rate(prometheus_remote_storage_samples_total{$alloy_selector}[5m])) + (sum by (url) (rate(prometheus_remote_storage_histograms_total{$alloy_selector}[5m])) or sum by (url) (rate(prometheus_remote_storage_samples_total{$alloy_selector}[5m])) * 0)",
