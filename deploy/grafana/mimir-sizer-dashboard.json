          },
          "expr": "label_replace(sum(label_replace(vector($samples / 25000), \"component\", \"distributor\", \"\", \"\") or label_replace(vector($series * $rf / 300000 * 2.5), \"component\", \"ingester\", \"\", \"\") or label_replace(vector($qps / 250), \"component\", \"query-frontend\", \"\", \"\") or label_replace(vector($qps / 500 * 0.1), \"component\", \"query-scheduler\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"querier\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"store-gateway\", \"\", \"\") or label_replace(vector($rules / 10), \"component\", \"ruler\", \"\", \"\") or label_replace(clamp_min(ceil(vector($series / 20000000)), 1) * 4, \"component\", \"compactor\", \"\", \"\") or label_replace(vector($firing_alerts / 5000), \"component\", \"alertmanager\", \"\", \"\")), \"scope\", \"cluster total\", \"\", \"\") or label_replace(sum(label_replace(vector($samples / 25000), \"component\", \"distributor\", \"\", \"\") or label_replace(vector($series * $rf / 300000 * 2.5), \"component\", \"ingester\", \"\", \"\") or label_replace(vector($qps / 250), \"component\", \"query-frontend\", \"\", \"\") or label_replace(vector($qps / 500 * 0.1), \"component\", \"query-scheduler\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"querier\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"store-gateway\", \"\", \"\") or label_replace(vector($rules / 10), \"component\", \"ruler\", \"\", \"\") or label_replace(clamp_min(ceil(vector($series / 20000000)), 1) * 4, \"component\", \"compactor\", \"\", \"\") or label_replace(vector($firing_alerts / 5000), \"component\", \"alertmanager\", \"\", \"\")) / $rf, \"scope\", \"per instance (÷ RF, rough)\", \"\", \"\")",
          "format": "table",
