{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "Sizing per the [Mimir capacity planning guide](https://grafana.com/docs/mimir/latest/manage/run-production-environment/planning-capacity/). Measured inputs are **peaks over the dashboard time range**; unknown inputs are 0 — set the override variables for a new setup. Alloy tables need Alloy self-metrics in the selected datasource.",
        "mode": "markdown"
      },
      "title": "About",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($series)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Active series",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($samples)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Samples/s",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($scrape_interval)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Scrape interval (s)",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($qps)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Queries/s",
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($rules)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Rule evals/s",
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($notifications)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Alert notifications/s",
          "range": false,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($firing_alerts)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Firing alerts",
          "range": false,
          "refId": "G"
        }
      ],
      "title": "Inputs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Minimum per component; +50% = recommended headroom for traffic peaks. Ruler sized for internal mode.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory +50%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk +50%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(vector($samples / 25000), \"component\", \"distributor\", \"\", \"\") or label_replace(vector($series * $rf / 300000), \"component\", \"ingester\", \"\", \"\") or label_replace(vector($qps / 250), \"component\", \"query-frontend\", \"\", \"\") or label_replace(vector($qps / 500), \"component\", \"query-scheduler\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"querier\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"store-gateway\", \"\", \"\") or label_replace(vector($rules / 10), \"component\", \"ruler\", \"\", \"\") or label_replace(clamp_min(ceil(vector($series / 20000000)), 1), \"component\", \"compactor\", \"\", \"\") or label_replace(vector($notifications / 100), \"component\", \"alertmanager\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(vector($samples / 25000), \"component\", \"distributor\", \"\", \"\") or label_replace(vector($series * $rf / 300000 * 2.5), \"component\", \"ingester\", \"\", \"\") or label_replace(vector($qps / 250), \"component\", \"query-frontend\", \"\", \"\") or label_replace(vector($qps / 500 * 0.1), \"component\", \"query-scheduler\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"querier\", \"\", \"\") or label_replace(vector($qps / 10), \"component\", \"store-gateway\", \"\", \"\") or label_replace(vector($rules / 10), \"component\", \"ruler\", \"\", \"\") or label_replace(clamp_min(ceil(vector($series / 20000000)), 1) * 4, \"component\", \"compactor\", \"\", \"\") or label_replace(vector($firing_alerts / 5000), \"component\", \"alertmanager\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(vector(0), \"component\", \"distributor\", \"\", \"\") or label_replace(vector($series * $rf / 300000 * 5), \"component\", \"ingester\", \"\", \"\") or label_replace(vector(0), \"component\", \"query-frontend\", \"\", \"\") or label_replace(vector(0), \"component\", \"query-scheduler\", \"\", \"\") or label_replace(vector(0), \"component\", \"querier\", \"\", \"\") or label_replace(vector($series * $retention_days * 86400 / $scrape_interval * 2 * 0.001 * 3 / 1e9), \"component\", \"store-gateway\", \"\", \"\") or label_replace(vector(0), \"component\", \"ruler\", \"\", \"\") or label_replace(clamp_min(ceil(vector($series / 20000000)), 1) * 300, \"component\", \"compactor\", \"\", \"\") or label_replace(vector(0), \"component\", \"alertmanager\", \"\", \"\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Microservices mode",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Memory +50%",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Value #B"
                }
              },
              "operator": "*",
              "right": {
                "fixed": "1.5"
              }
            },
            "mode": "binary"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Disk +50%",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Value #C"
                }
              },
              "operator": "*",
              "right": {
                "fixed": "1.5"
              }
            },
            "mode": "binary"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "CPU cores",
              "Value #B": "Memory",
              "Value #C": "Disk"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "component"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
